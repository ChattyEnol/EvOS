/** Noyau/Enolcall.c
 *
 * (C) Charity Enol
 *
 * POSIX 风格的极简系统调用分发器。
 */

#include <Noyau/Process.h>
#include <Noyau/Enolcall.h>
#include <UI/TextIO.h>

#include <stddef.h>
#include <stdint.h>

#define ENOL_STDIN 0
#define ENOL_STDOUT 1
#define ENOL_STDERR 2

#define ENOL_EINVAL (-22)
#define ENOL_EBADF (-9)
#define ENOL_ENOSYS (-38)

/**
 * 分发 read 系统调用。
 */
static int64_t SysRead(int fd, void *buffer, uint64_t size);

/**
 * 分发 write 系统调用。
 */
static int64_t SysWrite(int fd, const void *buffer, uint64_t size);

/**
 * 分发 exit 系统调用。
 */
static int64_t SysExit(int status);

/**
 * 分发 getpid 系统调用。
 */
static int64_t SysGetPID(void);

/**
 * 分发 yield 系统调用。
 */
static int64_t SysYield(void);

uint64_t EnolCaller(INTERRUPT_FRAME *frame)
{
    if (frame == NULL)
        return (uint64_t)ENOL_EINVAL;

    int64_t result;

    switch ((ENOLCALL_NUMBER)frame->RAX)
    {
    case ENOL_READ:
        result = SysRead((int)frame->RDI, (void *)(uintptr_t)frame->RSI, frame->RDX);
        break;
    case ENOL_WRITE:
        result = SysWrite((int)frame->RDI, (const void *)(uintptr_t)frame->RSI, frame->RDX);
        break;
    case ENOL_YIELD:
        result = SysYield();
        break;
    case ENOL_GETPID:
        result = SysGetPID();
        break;
    case ENOL_EXIT:
        result = SysExit((int)frame->RDI);
        break;
    default:
        result = ENOL_ENOSYS;
        break;
    }

    frame->RAX = (uint64_t)result;
    return frame->RAX;
}

static int64_t SysRead(int fd, void *buffer, uint64_t size)
{
    if (fd != ENOL_STDIN)
        return ENOL_EBADF;

    if (buffer == NULL || size == 0)
        return ENOL_EINVAL;

    TEXT_INPUT input;
    if (!ReadTextInput(&input) || input.Character == '\0')
        return 0;

    ((char *)buffer)[0] = input.Character;
    return 1;
}

static int64_t SysWrite(int fd, const void *buffer, uint64_t size)
{
    if (fd != ENOL_STDOUT && fd != ENOL_STDERR)
        return ENOL_EBADF;

    if (buffer == NULL && size != 0)
        return ENOL_EINVAL;

    const char *text = (const char *)buffer;
    for (uint64_t index = 0; index < size; index++)
        TextPutChar(text[index]);

    return (int64_t)size;
}

static int64_t SysExit(int status)
{
    (void)status;

    PROCESS_ID processID = GetCurrentProcessID();
    if (processID != 0)
        SetProcessState(processID, PROCESS_STOPPED);

    YieldProcess();
    return 0;
}

static int64_t SysGetPID(void)
{
    return (int64_t)GetCurrentProcessID();
}

static int64_t SysYield(void)
{
    YieldProcess();
    return 0;
}
